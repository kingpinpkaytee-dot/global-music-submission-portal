# Server-side worker configuration only.
# Add these as GitHub Actions repository secrets. Never expose them in VITE_ variables.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_KEY
DATAFORSEO_LOGIN=YOUR_DATAFORSEO_API_LOGIN
DATAFORSEO_PASSWORD=YOUR_DATAFORSEO_API_PASSWORD

# Optional: 1 query per hourly run is the cost-controlled default. Maximum supported: 2.
DISCOVERY_SEARCHES_PER_RUN=1
