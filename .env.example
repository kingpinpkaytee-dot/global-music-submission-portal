# Copy to .env.local for local development.
# These values are public client configuration, not secrets.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# NEVER put a Supabase service-role key in a VITE_ variable or browser bundle.
# Keep privileged keys only in server-side secrets / Edge Function secrets.
